DATABASE_URL="file:./data/fitr.db"
# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Text and vision: tagging photos, outfits, shop tips (free) ---
# Free key from https://aistudio.google.com/apikey — the app runs without one, minus the AI.
GEMINI_API_KEY=""
# Must be on the free tier for a free setup.
GEMINI_MODEL="gemini-3.8-flash"

# --- Images: studio photos and try-on (paid with every provider) ---
# ChatGPT's image model. Key from https://platform.openai.com/api-keys; needs API credit
# (a ChatGPT Plus subscription does not include the API).
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL="gpt-image-2.5-sunburst"
# low, medium or high: higher looks better and costs more per image.
OPENAI_IMAGE_QUALITY="medium"
# Or Gemini's image model instead, on a billed Gemini key.
GEMINI_IMAGE_MODEL=""
# Only needed when both are set up: "openai" or "gemini".
IMAGE_PROVIDER=""

# Where photos are stored.
UPLOADS_DIR="./data/uploads"
