DATABASE_URL="file:./data/fitr.db"
# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Free key from https://aistudio.google.com/apikey — the app runs without one, minus the AI.
GEMINI_API_KEY=""
# Text + vision model. Must be on the free tier for a free setup.
GEMINI_MODEL="gemini-3.8-flash"
# Image model for studio photos and try-on. Not on Gemini's free tier; leave empty to hide those features.
GEMINI_IMAGE_MODEL=""
# Where photos are stored.
UPLOADS_DIR="./data/uploads"
